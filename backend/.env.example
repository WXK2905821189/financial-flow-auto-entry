# 环境：dev / prod
ENVIRONMENT=dev

# 数据库（独立部署，仅财务网段可访问；D7=A 轻量关系库 MySQL 8.0）
DATABASE_URL=mysql+pymysql://waterflow:CHANGE_ME@127.0.0.1:3306/waterflow?charset=utf8mb4

# 简版登录（D2=A）：JWT 签名密钥 + 初始管理员（首次启动自动播种，请上线前修改）
JWT_SECRET=CHANGE_ME_JWT_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# 银企直连服务（D6 主路：模拟银行 API 跑通生产链路；真实凭据 D3 就绪后切换）
BANK_API_BASE_URL=http://127.0.0.1:8080
# 签名密钥：生产经环境变量/内网密钥服务注入，禁止写死真实密钥（此处为开发占位值）
BANK_API_SIGN_SECRET=mock-bank-secret

# 金蝶云星空 OpenAPI（D8=A；第三方系统登录授权，凭据经环境变量注入，禁止写死 / 入库）
KINGDEE_BASE_URL=
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=
KINGDEE_ACCT_ID=
KINGDEE_USER_NAME=
KINGDEE_LCID=2052
KINGDEE_ORG_NUM=0
KINGDEE_TIMEOUT=30
# 开发/演示期凭据未就绪：启用 Mock 推送走通端到端（9/16 链路打通）；上线前置 false
KINGDEE_MOCK_ENABLED=true

# 复核规则阈值（人民币，超过该金额转人工复核；规则 R004）
REVIEW_AMOUNT_THRESHOLD=100000

# 校验通过后是否自动通过（true=规则内自动通过；false=全部转人工复核）
AUTO_PASS_ENABLED=true